# Generated by matugen from the current wallpaper.
# Do not edit: run `theme <image>` instead.

# OS segment
set -g tide_os_bg_color "{{ colors.surface_container_high.default.hex }}"
set -g tide_os_color "{{ colors.primary.default.hex }}"

# Current directory: bright pill, dark icons/text (home icon stays visible)
set -g tide_pwd_bg_color "{{ colors.primary.default.hex }}"
set -g tide_pwd_color_dirs "{{ colors.on_primary.default.hex }}"
set -g tide_pwd_color_anchors "{{ colors.on_primary.default.hex }}"
set -g tide_pwd_color_truncated_dirs "{{ colors.on_primary.default.hex }}"

# Prompt character
set -g tide_character_color "{{ colors.primary.default.hex }}"
set -g tide_character_color_failure "{{ colors.error.default.hex }}"

# Separators and framed prompts
set -g tide_prompt_color_separator_same_color "{{ colors.surface_container_high.default.hex }}"
set -g tide_prompt_color_frame_and_connection "{{ colors.outline.default.hex }}"

# Right prompt items
set -g tide_status_bg_color "{{ colors.surface_container_high.default.hex }}"
set -g tide_status_color "{{ colors.error.default.hex }}"

set -g tide_cmd_duration_bg_color "{{ colors.secondary_container.default.hex }}"
set -g tide_cmd_duration_color "{{ colors.on_secondary_container.default.hex }}"

set -g tide_context_bg_color "{{ colors.surface_container.default.hex }}"
set -g tide_context_color_default "{{ colors.on_surface_variant.default.hex }}"
set -g tide_context_color_root "{{ colors.error.default.hex }}"
set -g tide_context_color_ssh "{{ colors.tertiary.default.hex }}"

set -g tide_jobs_bg_color "{{ colors.tertiary_container.default.hex }}"
set -g tide_jobs_color "{{ colors.on_tertiary_container.default.hex }}"

set -g tide_python_bg_color "{{ colors.secondary_container.default.hex }}"
set -g tide_python_color "{{ colors.on_secondary_container.default.hex }}"

set -g tide_time_bg_color "{{ colors.surface_container_high.default.hex }}"
set -g tide_time_color "{{ colors.on_surface_variant.default.hex }}"

# Git (when inside a repository)
set -g tide_git_bg_color "{{ colors.tertiary_container.default.hex }}"
set -g tide_git_bg_color_unstable "{{ colors.secondary_container.default.hex }}"
set -g tide_git_bg_color_urgent "{{ colors.error_container.default.hex }}"
set -g tide_git_color_branch "{{ colors.on_tertiary_container.default.hex }}"
set -g tide_git_color_operation "{{ colors.on_tertiary_container.default.hex }}"
set -g tide_git_color_staged "{{ colors.on_tertiary_container.default.hex }}"
set -g tide_git_color_dirty "{{ colors.on_secondary_container.default.hex }}"
set -g tide_git_color_untracked "{{ colors.on_secondary_container.default.hex }}"
set -g tide_git_color_upstream "{{ colors.on_tertiary_container.default.hex }}"
set -g tide_git_color_conflicted "{{ colors.on_error_container.default.hex }}"
set -g tide_git_color_stash "{{ colors.on_tertiary_container.default.hex }}"
