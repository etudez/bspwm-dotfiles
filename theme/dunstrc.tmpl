# Generated by matugen from the current wallpaper.
# Do not edit: run `theme <image>` instead.

[global]
    monitor = 0
    follow = none
    width = (0, 340)
    origin = top-center
    offset = 0x2a
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 8
    frame_width = 1
    gap_size = 8
    sort = yes
    idle_threshold = 120
    font = Roboto 10
    line_height = 4
    markup = full
    format = "%s\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 120
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    icon_position = off
    min_icon_size = 0
    max_icon_size = 32
    sticky_history = yes
    history_length = 20
    dmenu = rofi -dmenu -p dunst
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    frame_color = "{{ colors.outline_variant.default.hex }}"
    separator_color = "{{ colors.outline_variant.default.hex }}"
    highlight = "{{ colors.primary.default.hex }}"
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 3
    background = "{{ colors.surface_container.default.hex }}"
    foreground = "{{ colors.on_surface.default.hex }}"
    highlight = "{{ colors.primary.default.hex }}"

[urgency_normal]
    timeout = 5
    background = "{{ colors.surface_container.default.hex }}"
    foreground = "{{ colors.on_surface.default.hex }}"
    highlight = "{{ colors.primary.default.hex }}"

[urgency_critical]
    timeout = 0
    background = "{{ colors.surface_container_high.default.hex }}"
    foreground = "{{ colors.on_surface.default.hex }}"
    highlight = "{{ colors.error.default.hex }}"

# Desktop indicator shown by `bin/desk` (no status bar needed).
# dunst rules may only override a limited set of options, so the geometry and
# font come from [global]; the number is rendered large and centered.
[desktop_switch]
    appname = "dotfiles-osd"
    format = "<span size='xx-large' weight='bold'>%s</span>"
    alignment = "center"
    timeout = 650
    background = "{{ colors.surface_container_high.default.hex }}"
    foreground = "{{ colors.primary.default.hex }}"
    frame_color = "{{ colors.outline_variant.default.hex }}"

# Keyboard layout OSD (EN/РУ), shown by bin/layout-osd.
[layout_switch]
    appname = "dotfiles-layout"
    format = "<span size='xx-large' weight='bold'>%s</span>"
    alignment = "center"
    timeout = 1000
    background = "{{ colors.surface_container_high.default.hex }}"
    foreground = "{{ colors.primary.default.hex }}"
    frame_color = "{{ colors.outline_variant.default.hex }}"
