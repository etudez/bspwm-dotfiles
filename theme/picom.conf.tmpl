# Generated by matugen from the current wallpaper.
# Do not edit: run `theme <image>` instead.
#
# picom: Material You look, 1px outline windows, calm motion.
# Motion follows Material 3: emphasized-decelerate for entries,
# emphasized-accelerate for exits, short durations (150-220 ms).

backend = "glx";
vsync = true;
use-damage = true;
detect-client-opacity = true;
unredir-if-possible = false;

# Windows: square corners, 1px borders, soft shadows.
corner-radius = 0;

shadow = true;
shadow-radius = 18;
shadow-opacity = 0.35;
shadow-offset-x = 0;
shadow-offset-y = 6;
shadow-color = "{{ colors.shadow.default.hex }}";

# Rofi and dunst surfaces are translucent, so the wallpaper gets a light
# Material "tonal glass" blur behind them.
blur-background = true;
blur-method = "dual_kawase";
blur-strength = 5;

fading = true;
fade-in-step = 0.08;
fade-out-step = 0.08;
fade-delta = 10;

# Window rules (the modern picom syntax; replaces *-exclude options).
rules = (
  {
    # Notifications, panels and the screenshot overlay draw no shadow.
    match = "class_g = 'Dunst' || window_type = 'dock' || window_type = 'desktop' || class_g = 'slop' || name = 'slop'";
    shadow = false;
  },
  {
    match = "window_type = 'dock' || window_type = 'desktop' || class_g = 'slop'";
    blur-background = false;
  },
  {
    # Rofi and dunst redraw/resize themselves constantly while filtering and
    # stacking. Animating their geometry looks springy, so it is disabled.
    match = "class_g = 'Rofi' || class_g = 'Dunst'";
    animations = ({
      triggers = [ "geometry" ];
      duration = 0.001;
    });
  }
);

# --- Motion -----------------------------------------------------------------

animations = (
  {
    triggers = [ "open" ];
    opacity = {
      curve = "cubic-bezier(0.05, 0.7, 0.1, 1.0)";
      duration = 0.22;
      start = 0.0;
      end = 1.0;
    };
    offset-y = {
      curve = "cubic-bezier(0.05, 0.7, 0.1, 1.0)";
      duration = 0.22;
      start = 10;
      end = 0;
    };
    shadow-offset-y = {
      curve = "cubic-bezier(0.05, 0.7, 0.1, 1.0)";
      duration = 0.22;
      start = 16;
      end = 6;
    };
    shadow-opacity = {
      curve = "cubic-bezier(0.05, 0.7, 0.1, 1.0)";
      duration = 0.22;
      start = 0.0;
      end = 0.35;
    };
  },
  {
    triggers = [ "close" ];
    opacity = {
      curve = "cubic-bezier(0.3, 0.0, 0.8, 0.15)";
      duration = 0.15;
      start = 1.0;
      end = 0.0;
    };
    offset-y = {
      curve = "cubic-bezier(0.3, 0.0, 0.8, 0.15)";
      duration = 0.15;
      start = 0;
      end = 8;
    };
    shadow-offset-y = {
      curve = "cubic-bezier(0.3, 0.0, 0.8, 0.15)";
      duration = 0.15;
      start = 6;
      end = 14;
    };
    shadow-opacity = {
      curve = "cubic-bezier(0.3, 0.0, 0.8, 0.15)";
      duration = 0.15;
      start = 0.35;
      end = 0.0;
    };
  },
  {
    # Desktop switches: unmap/map of bspwm windows.
    triggers = [ "show" ];
    opacity = {
      curve = "cubic-bezier(0.05, 0.7, 0.1, 1.0)";
      duration = 0.18;
      start = 0.0;
      end = 1.0;
    };
  },
  {
    triggers = [ "hide" ];
    opacity = {
      curve = "cubic-bezier(0.3, 0.0, 0.8, 0.15)";
      duration = 0.12;
      start = 1.0;
      end = 0.0;
    };
  },
  {
    # The bspwm signature move: tiled windows glide into place when the
    # layout, gaps or split ratios change.
    triggers = [ "geometry" ];
    preset = "geometry-change";
    duration = 0.20;
  }
);
