#!/bin/sh
# bspwm — Material You, no status bar
# https://github.com/baskerville/bspwm

# --- Palette (generated by `theme`) -----------------------------------------
[ -f "$HOME/.config/bspwm/colors.sh" ] && . "$HOME/.config/bspwm/colors.sh"

: "${COLOR_PRIMARY:=#89d0ee}"
: "${COLOR_PRIMARY_CONTAINER:=#004d62}"
: "${COLOR_ERROR:=#ffb4ab}"
: "${COLOR_SURFACE:=#0f1417}"
: "${COLOR_OUTLINE_VARIANT:=#40484c}"

# --- Session ----------------------------------------------------------------
# Never inherit the directory bspwm happened to be started from.
cd "$HOME" 2>/dev/null || true

# Runtime directory, session bus and PipeWire environment.
[ -f "$HOME/.config/session/env.sh" ] && . "$HOME/.config/session/env.sh"

# PipeWire is optional; the script exits quietly when it is not installed.
if [ -x "$HOME/.local/bin/pipewire-start" ]; then
    "$HOME/.local/bin/pipewire-start" || true
fi

# Keep the monitor on during idle.
if [ -x "$HOME/.local/bin/no-blank" ]; then
    "$HOME/.local/bin/no-blank" || true
fi

# Cursor theme for X11 clients launched from bspwm/sxhkd.
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Classic}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

command -v setxkbmap >/dev/null 2>&1 &&
    setxkbmap -layout us,ru -option grp:alt_shift_toggle,grp_led:scroll

# bspwm leaves the root cursor as the X fallback; set it from Bibata.
if [ -x "$HOME/.local/bin/cursor" ] && command -v python3 >/dev/null 2>&1; then
    "$HOME/.local/bin/cursor" || true
fi

# Highest refresh rate at the current resolution (e.g. 1920x1080 @ 144 Hz).
if [ -x "$HOME/.local/bin/display" ]; then
    "$HOME/.local/bin/display" || true
fi

# Keyboard layout OSD (EN/РУ) when the XKB group changes.
if [ -x "$HOME/.local/bin/layout-osd" ] && command -v python3 >/dev/null 2>&1; then
    pgrep -f '/layout-osd$' >/dev/null 2>&1 ||
        "$HOME/.local/bin/layout-osd" >/dev/null 2>&1 &
fi

if [ -f "$HOME/.config/X11/xresources" ] && command -v xrdb >/dev/null 2>&1; then
    xrdb -merge "$HOME/.config/X11/xresources"
fi

# Wallpaper chosen by the last `theme` run.
wall=$(cat "$HOME/.cache/dotfiles/wallpaper" 2>/dev/null)
[ -n "$wall" ] && [ -f "$wall" ] ||
    wall="$HOME/dotfiles/wallpapers/default.png"
if command -v feh >/dev/null 2>&1 && [ -f "$wall" ]; then
    feh --no-fehbg --bg-fill "$wall"
fi

# Compositor (animations live here).
if command -v picom >/dev/null 2>&1 && ! pgrep -x picom >/dev/null 2>&1; then
    picom --config "$HOME/.config/picom/picom.conf" --daemon
fi

# Notifications.
if command -v dunst >/dev/null 2>&1 && ! pgrep -x dunst >/dev/null 2>&1; then
    dunst &
fi

# Authentication agent (mounting drives, privileged actions).
for agent in \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/bin/lxpolkit; do
    if [ -x "$agent" ]; then
        pgrep -f "$(basename "$agent")" >/dev/null 2>&1 || "$agent" &
        break
    fi
done

# Hotkeys.
pgrep -x sxhkd >/dev/null 2>&1 ||
    sxhkd -c "$HOME/.config/sxhkd/sxhkdrc" &

# Lock the session on idle (X screen saver).
if command -v xss-lock >/dev/null 2>&1; then
    pgrep -x xss-lock >/dev/null 2>&1 ||
        xss-lock -- "$HOME/.local/bin/lock" &
fi

# Top bar (also sets bspwm's top padding).
if [ -x "$HOME/.local/bin/bar" ]; then
    "$HOME/.local/bin/bar" start || true
fi

# StatusNotifier → XEmbed bridge for the Polybar tray.
if command -v snixembed >/dev/null 2>&1; then
    pgrep -x snixembed >/dev/null 2>&1 || snixembed &
fi

# --- Desktop layout ---------------------------------------------------------
bspc monitor -d 1 2 3 4 5 6 7 8 9

bspc config border_width        2
bspc config window_gap          8
bspc config split_ratio         0.5
bspc config borderless_monocle  true
bspc config gapless_monocle     true
bspc config single_monocle      false
bspc config focus_follows_pointer false
bspc config pointer_follows_focus false

# Super + drag moves, Super + right/middle drag resizes.
bspc config pointer_modifier     mod4
bspc config pointer_action1      move
bspc config pointer_action2      resize_side
bspc config pointer_action3      resize_corner

# --- Material outline --------------------------------------------------------
bspc config normal_border_color    "$COLOR_PRIMARY_CONTAINER"
bspc config focused_border_color   "$COLOR_PRIMARY"
bspc config active_border_color    "$COLOR_PRIMARY"
bspc config presel_feedback_color  "$COLOR_PRIMARY_CONTAINER"
bspc config urgent_border_color    "$COLOR_ERROR"

# --- Monitors ---------------------------------------------------------------
bspc config remove_disabled_monitors    true
bspc config remove_unplugged_monitors   true
bspc config merge_overlapping_monitors  true

# --- Rules ------------------------------------------------------------------
bspc rule -a Gimp          desktop='^9' state=floating follow=on
bspc rule -a mpv           state=floating
bspc rule -a pavucontrol   state=floating
bspc rule -a Lxappearance  state=floating
bspc rule -a file-roller   state=floating
bspc rule -a Rofi          state=floating
bspc rule -a Dunst         state=floating
bspc rule -a Yad           state=floating
