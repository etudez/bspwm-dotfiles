@import "colors.rasi"
@import "state.rasi"

* {
    background-color: transparent;
    text-color:       @on-surface;
    font:             "Roboto 11";
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            540px;
    padding:          10px;
    border:           1px;
    border-color:     @outline-variant;
    border-radius:    0;
    background-color: @surface-container;
}

mainbox {
    padding: 2px;
    spacing: 8px;
}

inputbar {
    padding:          12px 16px;
    spacing:          10px;
    border-radius:    0;
    background-color: @surface-container-high;
    children:         [ entry ];
}

entry {
    placeholder:       "Поиск";
    placeholder-color: @on-surface-variant;
    cursor:            text;
    text-color:        @on-surface;
}

listview {
    lines:        8;
    spacing:      2px;
    scrollbar:    false;
    fixed-height: true;
    dynamic:      false;
    padding:      4px 0 0 0;
}

element {
    padding:          8px 12px;
    spacing:          10px;
    border-radius:    0;
    background-color: transparent;
}

element-icon {
    size:            24px;
    vertical-align:  0.5;
}

element selected {
    background-color: @primary-container;
    text-color:       @on-primary-container;
}

element-text {
    vertical-align: 0.5;
}
