#!/bin/sh
# ~/.xinitrc — start bspwm; everything else is launched from bspwmrc.

# Cursor theme for every X11 client in the session.
export XCURSOR_THEME="${XCURSOR_THEME:-Bibata-Modern-Classic}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Runtime directory, session bus and PipeWire environment.
[ -f "$HOME/.config/session/env.sh" ] && . "$HOME/.config/session/env.sh"

# Keyboard layout: US/RU, Alt+Shift toggles.
if command -v setxkbmap >/dev/null 2>&1; then
    setxkbmap -layout us,ru -option grp:alt_shift_toggle,grp_led:scroll || true
fi

# Keep the monitor on during idle.
if [ -x "$HOME/.local/bin/no-blank" ]; then
    "$HOME/.local/bin/no-blank" || true
fi

# Apps inherit this working directory; keep it sane.
cd "$HOME" 2>/dev/null || true

if [ -f "$HOME/.config/X11/xresources" ] && command -v xrdb >/dev/null 2>&1; then
    xrdb -merge "$HOME/.config/X11/xresources"
fi

bspwm
