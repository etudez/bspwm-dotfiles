#!/usr/bin/env bash
# Rofi script-mode dashboard: the control center of a barless desktop.
# Super+D opens it.

set -u

self=$(readlink -f "$0")
DOTFILES=${DOTFILES:-$(cd "$(dirname "$self")/.." && pwd)}
[ -f "$HOME/.config/bspwm/colors.sh" ] && . "$HOME/.config/bspwm/colors.sh"

entry() { # icon label value action
    local pad
    pad=$((12 - ${#2}))
    [ "$pad" -lt 0 ] && pad=0
    printf '%s  %s%s  %s\0info\x1f%s\n' \
        "$1" "$2" "$(printf '%*s' "$pad" '')" "$3" "$4"
}

# rofi script mode still owns the keyboard grab for a moment after a selection.
# Delay and detach actions that open another rofi window.
launch() {
    if command -v setsid >/dev/null 2>&1; then
        setsid bash -c 'sleep 0.25; exec "$@"' _ "$@" >/dev/null 2>&1 &
    else
        (sleep 0.25; exec "$@") >/dev/null 2>&1 &
    fi
}

case "${ROFI_RETV:-0}" in
    0)
        entry "󰥔" "Время" "$(date '+%H:%M  %a %d %b')" noop

        vol=$("$DOTFILES/bin/volume" get 2>/dev/null || true)
        muted=$("$DOTFILES/bin/volume" muted 2>/dev/null || echo no)
        if [ "$muted" = yes ]; then voltxt="выкл"; else voltxt="${vol:-?}%"; fi
        entry "󰕾" "Звук" "$voltxt" sound
        entry "󰍬" "Микрофон" "настроить" mic

        bright=$("$DOTFILES/bin/brightness" get 2>/dev/null || true)
        [ -n "$bright" ] && [ "$bright" != "--" ] &&
            entry "󰃠" "Яркость" "${bright}%" noop

        iface=$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')
        if [ -n "$iface" ]; then
            addr=$(ip -4 -o addr show dev "$iface" 2>/dev/null |
                awk '{print $4}' | head -n1)
            addr=${addr%%/*}
            entry "󰖩" "Сеть" "$iface ${addr:-(без IPv4)}" noop
        else
            entry "󰖩" "Сеть" "нет сети" noop
        fi

        bat=$(find /sys/class/power_supply -maxdepth 2 -name capacity 2>/dev/null | head -n1)
        if [ -n "$bat" ]; then
            entry "󰁹" "Батарея" "$(cat "$bat" 2>/dev/null)%" noop
        fi

        entry "󰋊" "Диск" "$(df -h / | awk 'NR==2 {print $4}') свободно" noop
        entry "󰉋" "Файлы" "Thunar" files
        entry "󰖟" "Браузер" "Firefox" browser
        entry "󰸉" "Обои" "сменить палитру" theme
        entry "󰌌" "Хоткеи" "Super+F1" help
        entry "󰌾" "Блокировка" "Super+Escape" lock
        entry "󰐥" "Питание" "сон, перезагрузка…" power
        ;;
    1)
        case ${ROFI_INFO:-} in
            sound) launch "$DOTFILES/bin/sound" ;;
            mic) launch "$DOTFILES/bin/mic" ;;
            files) launch thunar "$HOME" ;;
            browser) launch "$DOTFILES/bin/browser" ;;
            theme) launch "$DOTFILES/bin/theme-pick" ;;
            help)  launch "$DOTFILES/bin/help" ;;
            lock)  launch "$DOTFILES/bin/lock" ;;
            power) launch "$DOTFILES/bin/powermenu" ;;
        esac
        ;;
esac
