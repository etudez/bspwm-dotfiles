#!/bin/sh
# Start PipeWire, WirePlumber and the PulseAudio-compatible server for the
# current X session. Safe to call repeatedly; exits silently if PipeWire is not
# installed.

command -v pipewire >/dev/null 2>&1 || exit 0

runtime=${XDG_RUNTIME_DIR:-$HOME/.run}
mkdir -p "$runtime" 2>/dev/null || true
chmod 700 "$runtime" 2>/dev/null || true
export XDG_RUNTIME_DIR="$runtime"
export PIPEWIRE_RUNTIME_DIR="$runtime"
export PULSE_SERVER="${PULSE_SERVER:-unix:$runtime/pulse/native}"

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -d "$HOME/.dbus/session-bus" ]; then
    for f in "$HOME"/.dbus/session-bus/*; do
        [ -r "$f" ] || continue
        . "$f"
        [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && break
    done
fi
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && export DBUS_SESSION_BUS_ADDRESS

log="$HOME/.cache/pipewire-start.log"
mkdir -p "$HOME/.cache" 2>/dev/null || true

start() {
    command -v "$1" >/dev/null 2>&1 || return 0
    pgrep -x "$1" >/dev/null 2>&1 && return 0
    "$1" >>"$log" 2>&1 &
}

start pipewire

i=0
while [ ! -S "$runtime/pipewire-0" ] && [ "$i" -lt 30 ]; do
    sleep 0.1
    i=$((i + 1))
done

start wireplumber
start pipewire-pulse
