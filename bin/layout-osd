#!/usr/bin/env python3
"""Show the active keyboard layout as a small OSD when it changes.

Uses XKB state polling (4 Hz) and dunstify/notify-send for the popup. Started
from bspwmrc; exits cleanly when the X display goes away.
"""

import ctypes
import os
import shutil
import subprocess
import sys
import time
from ctypes import (POINTER, Structure, byref, c_char_p, c_int, c_ubyte,
                    c_uint, c_ulong, c_ushort, c_void_p)

LABELS = {
    "us": "EN", "ru": "РУ", "ua": "УК", "by": "BY", "kz": "KZ",
    "de": "DE", "fr": "FR", "es": "ES", "it": "IT", "pl": "PL",
    "cz": "CZ", "sk": "SK", "tr": "TR", "jp": "JP", "cn": "CN",
    "kr": "KR", "pt": "PT", "nl": "NL", "se": "SE", "no": "NO",
}


class XkbStateRec(Structure):
    _fields_ = [
        ("group", c_ubyte), ("locked_group", c_ubyte),
        ("base_group", c_ushort), ("latched_group", c_ushort),
        ("mods", c_ubyte), ("base_mods", c_ubyte),
        ("latched_mods", c_ubyte), ("locked_mods", c_ubyte),
        ("compat_state", c_ubyte), ("grab_mods", c_ubyte),
        ("compat_grab_mods", c_ubyte), ("lookup_mods", c_ubyte),
        ("compat_lookup_mods", c_ubyte), ("ptr_buttons", c_ushort),
    ]


def layouts():
    try:
        out = subprocess.run(["setxkbmap", "-query"], capture_output=True,
                             text=True, timeout=2).stdout
    except Exception:
        return []
    for line in out.splitlines():
        if line.strip().startswith("layout:"):
            return [x.strip() for x in line.split(":", 1)[1].split(",") if x.strip()]
    return []


def notify(label):
    if shutil.which("dunstify"):
        cmd = ["dunstify", "-a", "dotfiles-layout",
               "-h", "string:x-dunst-stack-tag:layout",
               "-u", "low", "-t", "800", label, ""]
    elif shutil.which("notify-send"):
        cmd = ["notify-send", "-a", "dotfiles-layout", "-t", "800", label]
    else:
        return
    if os.environ.get("LAYOUT_OSD_DEBUG"):
        print("notify:", cmd, flush=True)
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass


def main():
    x11 = ctypes.CDLL("libX11.so.6")
    x11.XOpenDisplay.argtypes = [c_char_p]
    x11.XOpenDisplay.restype = c_void_p
    x11.XkbGetState.argtypes = [c_void_p, c_uint, POINTER(XkbStateRec)]
    x11.XkbGetState.restype = c_int

    dpy = x11.XOpenDisplay(None)
    if not dpy:
        print("layout-osd: cannot open display", file=sys.stderr)
        return 1

    names = layouts()
    state = XkbStateRec()
    if x11.XkbGetState(dpy, 0x0100, byref(state)) != 0:  # XkbUseCoreKbd
        return 1

    last = state.group
    while True:
        time.sleep(0.2)
        if x11.XkbGetState(dpy, 0x0100, byref(state)) != 0:
            return 0
        group = state.group
        if group == last:
            continue
        last = group
        if os.environ.get("LAYOUT_OSD_DEBUG"):
            print("group ->", group, names, flush=True)
        code = names[group] if group < len(names) else str(group + 1)
        notify(LABELS.get(code, code.upper()))


if __name__ == "__main__":
    sys.exit(main())
