#!/usr/bin/env bash
# mic — rofi panel for ALSA capture settings.
#
# Source, capture level, mute, boost and alsamixer; applies immediately.

set -u

self=$(readlink -f "$0")
DOTFILES=${DOTFILES:-$(cd "$(dirname "$self")/.." && pwd)}
THEME="$HOME/.config/rofi/mic.rasi"

card=$(aplay -l 2>/dev/null | sed -n 's/^card \([0-9]*\):.*Analog.*/\1/p' | head -n1)
[ -n "$card" ] || card=0

am() { amixer -c "$card" "$@" 2>/dev/null; }

source_value() {
    am cget name='Input Source' | sed -n 's/.*values=//p' | head -n1
}

source_names() {
    am cget name='Input Source' |
        sed -n "s/.*Item #\([0-9][0-9]*\) '\(.*\)'/\2/p"
}

capture_pct() {
    am sget Capture | grep -o '[0-9][0-9]*%' | head -n1 | tr -d '%'
}

capture_switch() {
    am sget Capture | grep -o '\[on\]\|\[off\]' | head -n1
}

boost_ctl() {
    case $(source_value) in
        1) echo 'Front Mic Boost' ;;
        *) echo 'Rear Mic Boost' ;;
    esac
}

boost_value() {
    am sget "$(boost_ctl)" | sed -n 's/.*Front Left: \([0-9][0-9]*\).*/\1/p' | head -n1
}

row() { # icon label value action
    local icon=$1 label=$2 value=$3 action=$4 pad
    pad=$((16 - ${#label}))
    [ "$pad" -lt 0 ] && pad=0
    labels+=("$icon  $label$(printf '%*s' "$pad" '')  $value")
    actions+=("$action")
}

if ! command -v rofi >/dev/null 2>&1; then
    am sget Capture
    exit 0
fi

# PipeWire is running: pavucontrol is the right tool for sources and routes.
if command -v wpctl >/dev/null 2>&1 &&
   command -v pavucontrol >/dev/null 2>&1 &&
   wpctl status >/dev/null 2>&1; then
    exec pavucontrol
fi

while :; do
    labels=()
    actions=()

    cur=$(source_value)
    mapfile -t names < <(source_names)
    for i in "${!names[@]}"; do
        if [ "$i" = "$cur" ]; then mark="●"; value="текущий"; else mark=" "; value=""; fi
        row "$mark 󰍬" "${names[$i]}" "$value" "source:${i}"
    done

    cap=$(capture_pct)
    sw=$(capture_switch)
    [ -n "$cap" ] || cap=0
    if [ "$sw" = "[off]" ]; then state="off"; else state="${cap}%"; fi
    row "󰍬" "Capture" "$state" noop
    row "󰍮" "Mute" "$sw" mute

    step=$(( (cap + 10) / 20 * 20 ))
    [ "$step" -gt 100 ] && step=100
    for p in 0 20 40 60 80 100; do
        if [ "$p" = "$step" ]; then mark="●"; else mark=" "; fi
        row "$mark 󰍬" "${p}%" "" "cap:${p}"
    done

    bv=$(boost_value)
    [ -n "$bv" ] || bv=0
    for b in 0 1 2 3; do
        if [ "$b" = "$bv" ]; then mark="●"; else mark=" "; fi
        row "$mark 󰎆" "Boost ${b}" "" "boost:${b}"
    done

    row "󰘊" "Микшер" "alsamixer" mixer

    sel=$(for i in "${!labels[@]}"; do printf '%s\n' "${labels[$i]}"; done |
        rofi -dmenu -i -no-custom -format i -theme "$THEME" \
            -p "" -mesg "  󰍬  Микрофон" 2>/dev/null) || exit 0
    [ -n "$sel" ] || exit 0
    [[ $sel =~ ^[0-9]+$ ]] || exit 0
    action=${actions[$sel]:-noop}

    case $action in
        noop) ;;
        source:*) am cset name='Input Source' "${action#source:}" >/dev/null ;;
        cap:*)    am sset Capture "${action#cap:}%" cap >/dev/null ;;
        mute)     am sset Capture toggle >/dev/null ;;
        boost:*)  am sset "$(boost_ctl)" "${action#boost:}" >/dev/null ;;
        mixer)    exec kitty --title alsamixer alsamixer -c "$card" ;;
    esac
done
